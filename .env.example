# ============================================================
# .env.example (raíz) — variables de entorno del frontend Next.js
# Copia a .env.local y ajusta. Nunca versiones .env.local.
# ============================================================

# URL base del backend FastAPI.
# Desarrollo local (valor por defecto en el código si no se define):
NEXT_PUBLIC_API_URL=http://localhost:8000

# PRODUCCIÓN: URL pública del backend, p.ej.:
# NEXT_PUBLIC_API_URL=https://api.tudominio.cl
