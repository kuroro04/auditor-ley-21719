SECRET_KEY=change-me-in-production-use-a-long-random-string
DATABASE_URL=sqlite:///./backend.db
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Fase 5 — MFA (segundo factor TOTP opcional).
# Clave Fernet con la que se cifra en reposo el secreto TOTP de cada usuario.
# Fail-closed: sin ella el backend no arranca (salvo en tests). Genérala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENC_KEY=change-me-generate-a-fernet-key

# Fase 6 — copia externa de la bitácora de auditoría en Better Stack (opcional).
# Sin estas dos variables el envío queda desactivado y la app funciona igual.
# Ambos valores salen de la "source" HTTP creada en Better Stack Telemetry.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_HOST=

# Fase 4 — ClamAV (levantado con: docker compose up -d clamav)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
