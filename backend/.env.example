# ============================================================
# backend/.env.example — referencia de variables de entorno
# Copia este archivo a backend/.env y ajusta los valores.
# Nunca pongas backend/.env en el repositorio: está en .gitignore.
# ============================================================

# ── Claves criptográficas ────────────────────────────────────

# Clave secreta para firmar los tokens JWT de sesión.
# PRODUCCIÓN: genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# El backend rechaza arrancar si esta variable falta o vale el ejemplo.
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Clave Fernet con la que se cifra en reposo el secreto TOTP de cada usuario.
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Fail-closed: sin ella el backend no arranca (salvo en tests).
MFA_ENC_KEY=change-me-generate-a-fernet-key

# ── Entorno ──────────────────────────────────────────────────

# 'development' permite SQLite (sin Supabase) para desarrollo local.
# 'production'  exige PostgreSQL: con SQLite el backend rechaza arrancar
#               porque SQLite no soporta Row-Level Security (aislamiento multi-tenant).
ENVIRONMENT=development

# ── Base de datos ────────────────────────────────────────────

# SQLite (desarrollo local, sin servidor):
DATABASE_URL=sqlite:///./backend.db

# PostgreSQL / Supabase (producción):
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/dbname

# ── Frontend ─────────────────────────────────────────────────

# Origen exacto desde el que el navegador envía peticiones al backend.
# PRODUCCIÓN: reemplaza por el dominio real, p.ej. https://app.tudominio.cl
# No termines con /. El backend lo usa como lista de orígenes permitidos en CORS.
FRONTEND_ORIGIN=http://localhost:3000

# ── Cookies de sesión ────────────────────────────────────────

# 'true'  → la cookie solo viaja por HTTPS (obligatorio en producción).
# 'false' → la cookie viaja también por HTTP (solo para desarrollo local).
# El backend rechaza arrancar si esta variable no está definida.
COOKIE_SECURE=false

# ── Proxy inverso ────────────────────────────────────────────

# 'true'  → hay un proxy de confianza delante (Nginx, balanceador del
#           proveedor, etc.) que sobrescribe X-Forwarded-For antes de
#           reenviar la request; client_ip() leerá ese header para la bitácora.
# 'false' → la app está expuesta directamente a internet o en desarrollo
#           local; client_ip() usa la IP TCP real (request.client.host)
#           y el header X-Forwarded-For se ignora completamente.
# Por defecto 'false' para que el comportamiento seguro sea el predeterminado.
TRUST_PROXY=false

# ── Carga de archivos ────────────────────────────────────────

# Tamaño máximo de archivo aceptado por el backend (bytes). Defecto: 20 MB.
# Debe ser ligeramente menor que client_max_body_size de Nginx (ver docs/despliegue.md).
# MAX_UPLOAD_BYTES=20971520

# ── ClamAV ───────────────────────────────────────────────────

# Levántalo con: docker compose up -d clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Timeout en segundos para la conexión y el escaneo (opcional, defecto 15).
# CLAMAV_TIMEOUT_SECONDS=15

# ── Better Stack (copia externa de auditoría, opcional) ──────

# Sin estas dos variables el envío queda desactivado y la app funciona igual.
# Salen de la "source" HTTP creada en Better Stack Telemetry.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_HOST=
